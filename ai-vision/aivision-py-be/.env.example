# Django Settings - 配置模板
#
# 多环境配置说明：
# 根据 AIVISION_ENV 环境变量自动加载对应的配置文件：
#   - 未设置或 "development" → .env.development (本地开发)
#   - "prepub"                → .env.prepub (预发环境)
#   - "gray"                  → .env.gray (灰度环境)
#   - "prod"                  → .env.prod (生产环境)
#
# 部署时只需设置 AIVISION_ENV 环境变量，无需复制此文件

DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
CREDENTIAL_ENCRYPTION_KEY=your-shared-credential-encryption-key
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=mysql.connector.django
DB_NAME=aivision_dev_ds
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=2881

# Browser origins (comma-separated lists; set to your deployment URL)
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Logging (可选: DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO

# Configure Langfuse endpoints and project credentials in AI Vision.
# Optional credentials for deployments that expose a Langfuse provisioning API.
LANGFUSE_INTERNAL_AUTH_VALUE=
LANGFUSE_INTERNAL_API_TIMEOUT=30

# Optional: only used for local debugging of Langfuse API requests.
# When empty, requests will not attach a Cookie header.
LANGFUSE_DEBUG_COOKIE=

# OpenTelemetry 自观测
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Media content is stored/read exclusively through the SigNoz data plane.
# Maximum single file is 16 MiB. OTLP batches include base64 and metadata.
AIVISION_OTLP_MEDIA_REQUEST_MAX_BYTES=67108864

# V2 Agent Query Encryption
AGENT_QUERY_ENCRYPTION_ENABLED=True
AGENT_QUERY_ALLOW_PLAIN=False
# Example key only; override this key map with deployment-specific keys.
AGENT_QUERY_ENCRYPTION_KEYS={"dashboard-query-v1": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY"}
