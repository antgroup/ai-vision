# Django settings - container image defaults (AIVISION_ENV=container)
#
# Loaded by settings.py when the image runs. django-environ never overrides a
# variable that is already present in the process environment, so anything the
# deployment passes with `docker run -e` (or a compose `environment:` block)
# wins over the values below. Only deployment-independent, non-secret defaults
# belong here; hosts, ports, secrets and public URLs come from the deployment.

# The self-hosted stack is served over plain HTTP on the loopback interface.
# DEBUG=True keeps auth cookies non-Secure and CORS permissive, matching the
# behaviour of the source-based local stack. Set DEBUG=False behind TLS.
DEBUG=True
SECRET_KEY=aivision-container-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=aivision_backend.db_backends.mysql_connector_oceanbase
DB_NAME=aivision
DB_USER=root
DB_PASSWORD=
DB_HOST=obseekdb
DB_PORT=2881

# Browser origins (comma-separated; set to the URL users open)
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

DJANGO_LOG_LEVEL=INFO
AIVISION_LOG_DIR=/var/log/aivision

LANGFUSE_INTERNAL_AUTH_VALUE=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://antcollector-gw:4318/v1/traces
OTEL_SEMCONV_STABILITY_OPT_IN=http

# V2 Agent Query Encryption. The bundled frontend image is built without
# client-side encryption, so plain payloads must stay accepted.
AGENT_QUERY_ENCRYPTION_ENABLED=True
AGENT_QUERY_ALLOW_PLAIN=True
# Example key only; override this key map with deployment-specific keys.
AGENT_QUERY_ENCRYPTION_KEYS={"dashboard-query-v1": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY"}

# AgentLens diagnosis engine (container DNS name on the shared docker network)
AGENTLENS_BASE_URL=http://agentlens:8081
AGENTLENS_TOKEN=dev-token

# OTLP ingest token signing. MUST equal the gateway's AIVISION_INGEST_SECRET;
# the deployment sets both from one shared value.
AIVISION_INGEST_SECRET=
AIVISION_INGEST_TOKEN_TTL_SECONDS=900

# Agent market catalog + pre-built plugin artifacts baked into the image.
AIVISION_AGENT_PLUGINS_DIR=/agent-plugins
AIVISION_PLUGIN_ARTIFACTS_DIR=/agent-plugins/dist

SITE_URL=http://localhost:5174
AIVISION_PERSONAL_DIAGNOSIS_ENABLED=false
