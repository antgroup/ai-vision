#!/usr/bin/env bash
# AI Vision 构建脚本
# 用途：安装依赖、构建前端、准备后端
# 使用方式：./scripts/build/build.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BACKEND_DIR="${PROJECT_ROOT}/aivision-py-be"
FRONTEND_DIR="${PROJECT_ROOT}/vfe"
BUILD_DIR="${PROJECT_ROOT}/build"

echo "============================================================"
echo " AI Vision Build"
echo " Project root: ${PROJECT_ROOT}"
echo "============================================================"

# 获取版本信息
commit=
branch=
if git rev-parse --short HEAD > /dev/null 2>&1; then
  commit=$(git rev-parse --short HEAD)
  branch=$(git rev-parse --abbrev-ref HEAD)
fi

VERSION="${branch}-${commit}-$(date '+%Y%m%d_%H%M%S')"
echo "VERSION=${VERSION}"
echo ""

# ── Step 1: 安装后端 Python 依赖 ─────────────────────────────────────────────
echo "[1/4] Installing Python dependencies..."
cd "${BACKEND_DIR}"
uv sync
echo "      ✓ Python dependencies installed"

# ── Step 2: 构建前端 ───────────────────────────────────────────────────────────
echo ""
echo "[2/4] Building frontend..."
cd "${FRONTEND_DIR}"
if command -v pnpm &>/dev/null && [[ -f "pnpm-lock.yaml" ]]; then
    pnpm install --frozen-lockfile
    pnpm run build
else
    npm install
    npm run build
fi
echo "      ✓ Frontend built at ${FRONTEND_DIR}/dist"

# ── Step 3: 准备构建产物目录 ───────────────────────────────────────────────────
echo ""
echo "[3/4] Preparing build artifacts..."
rm -rf "${BUILD_DIR}"
mkdir -p "${BUILD_DIR}"

# 复制后端代码
cp -r "${BACKEND_DIR}" "${BUILD_DIR}/backend"

# 复制前端构建产物到后端 static 目录
mkdir -p "${BUILD_DIR}/backend/static"
cp -r "${FRONTEND_DIR}/dist/." "${BUILD_DIR}/backend/static/"

# 复制 index.html 到 templates 目录
mkdir -p "${BUILD_DIR}/backend/templates"
cp "${FRONTEND_DIR}/dist/index.html" "${BUILD_DIR}/backend/templates/"

# 创建版本文件
echo "${VERSION}" > "${BUILD_DIR}/VERSION"

echo "      ✓ Build artifacts prepared at ${BUILD_DIR}"

# ── Step 4: 收集静态文件 ─────────────────────────────────────────────────────
echo ""
echo "[4/4] Collecting static files..."
cd "${BUILD_DIR}/backend"
# 需要在有 .venv 的环境下运行
if [[ -f "${BACKEND_DIR}/.venv/bin/activate" ]]; then
    source "${BACKEND_DIR}/.venv/bin/activate"
    python manage.py collectstatic --noinput
fi
echo "      ✓ Static files collected"

# ── 完成 ───────────────────────────────────────────────────────────────────────
echo ""
echo "============================================================"
echo " Build complete!"
echo " VERSION: ${VERSION}"
echo " Output: ${BUILD_DIR}"
echo "============================================================"
ls -lh "${BUILD_DIR}"
