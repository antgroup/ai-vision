# AgentLens - 本地开发

# Database — 本地默认直连 OceanBase（MySQL 模式）

# 分拆连接参数（设置 AGENTLENS_OB_URL 为空时生效）
DB_ENGINE=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=2881
DB_USER=root
DB_PASSWORD=
DB_NAME=agentlens
OB_SQL_LOG_ENABLED=true

# 本地开发主路径：直连本机 OceanBase（MySQL 模式），覆盖上方分拆参数
AGENTLENS_OB_URL=mysql+pymysql://root%40atest:atest@127.0.0.1:2881/agentlens?charset=utf8mb4

# Auth
AGENTLENS_TOKEN=dev-token

# Server
AGENTLENS_PORT=8080

# SigNoz 遥测库（OceanBase）：原始 Trace / DiagnosisRecord / TaskStats 统一从这里读
SIGNOZ_OB_URL=mysql+pymysql://root%40atest:atest@127.0.0.1:2881/signoz_telemetry?charset=utf8mb4
# 必须与 SigNoz Collector 的 SIGNOZ_ORG_ID 一致
SIGNOZ_ORG_ID=ef0748a2-81ad-49fb-b566-22f1d4b81e59
SIGNOZ_SPANS_TABLE=signoz_traces


# OTLP 上报通道：SigNoz Collector OTLP/HTTP traces 完整地址
ANTCOLLECTOR_ENDPOINT=http://127.0.0.1:4318/v1/traces
ANTCOLLECTOR_ACCESS_ID=
ANTCOLLECTOR_ACCESS_TOKEN=

# Kernel
HEARTBEAT_INTERVAL_SEC=30
LEASE_TTL_SEC=120
DISPATCH_LOOP_INTERVAL_SEC=10
RESCUE_LOOP_INTERVAL_SEC=60
DISPATCH_TIMEOUT_SEC=300
MAX_TASK_ATTEMPTS=2
TASK_CLEANUP_ENABLED=true
TASK_RETENTION_DAYS=30
TASK_CLEANUP_INTERVAL_SEC=600
TASK_CLEANUP_BATCH_SIZE=1000
MASTER_EXECUTE_TASKS=true
MASTER_EXECUTE_CONCURRENCY=10
WORKER_EXECUTE_CONCURRENCY=10

# Custom Rule sandbox
CUSTOM_RULE_WORKER_POOL_SIZE=3
EXEC_TIMEOUT=5

# 首次访问空的具体 scope 时自动补齐的内置 Rule 场景（逗号分隔，置空关闭）
AGENTLENS_DEFAULT_BUILTIN_SCENARIOS=common,coding

# Logging
AGENTLENS_LOG_DIR=logs
AGENTLENS_LOG_LEVEL=INFO
AGENTLENS_LOG_STDOUT=true
AGENTLENS_LOG_RETENTION_DAYS=7
