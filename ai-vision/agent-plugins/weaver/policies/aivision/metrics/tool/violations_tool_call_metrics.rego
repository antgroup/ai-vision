package live_check_advice

import rego.v1
# @weaver.rule.title.zh: metric:tool 必须属性: tool_call_metric_missing_tool_type
# @weaver.rule.zh: 校验 metric:tool 的「必须属性」规则 `tool_call_metric_missing_tool_type`，确保遥测满足 AiVision 语义约定。
# @weaver.rule.entity: metric:tool
# @weaver.rule.category.zh: 必须属性
# @weaver.rule.fields: agent.tool_call.count, agentic.tool.type
# @weaver.rule.subject: field:agentic.tool.type
# @weaver.rule.placement: metric_data_point_attributes
# @weaver.rule.constraint.type: required_presence
# @weaver.rule.check.zh: Rego 条件命中 `tool_call_metric_missing_tool_type` 并产生 advice 时报告。
# @weaver.rule.fix.zh: 按 AiVision 语义约定补齐、重命名或移动相关字段；不要通过降低策略标准消除告警。

deny contains make_advice(
    "tool_call_metric_missing_tool_type",
    "violation",
    {"metric_name": get_metric_name, "attribute": "agentic.tool.type"},
    sprintf("Metric '%s': Missing required 'agentic.tool.type' (builtin/mcp/skill).", [get_metric_name])
) if {
    _is_tool_call_metric
    metric_dp_missing_attr("agentic.tool.type")
}
