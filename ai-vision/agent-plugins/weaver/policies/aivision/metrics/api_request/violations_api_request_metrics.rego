# @weaver.rule.title.zh: metric:api_request 不变量: api_request_error_count_wrong_type
# @weaver.rule.zh: RED API request Errors 指标 `agent.api_request.error.count` 必须是 sum/counter。
# @weaver.rule.entity: metric:api_request
# @weaver.rule.category.zh: 不变量
# @weaver.rule.fields: agent.api_request.error.count
# @weaver.rule.subject: field:agent.api_request.error.count
# @weaver.rule.placement: metric
# @weaver.rule.constraint.type: invariant
# @weaver.rule.check.zh: 当 `agent.api_request.error.count` 不是 sum/counter 指标时命中。
# @weaver.rule.fix.zh: 将 API request error count 导出为 monotonic sum，单位为 `{count}`。

deny contains make_advice(
    "api_request_error_count_wrong_type",
    "violation",
    {"metric_name": "agent.api_request.error.count"},
    "Metric 'agent.api_request.error.count': Expected counter (sum), found non-sum metric."
) if {
    _is_api_request_error_count
    not is_counter
}
