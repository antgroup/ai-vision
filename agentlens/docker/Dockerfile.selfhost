# AgentLens diagnosis engine - self-hosted distribution image.
#
# Build context is the agentlens/ directory:
#
#   docker build -f docker/Dockerfile.selfhost -t agentlens .
#
# Unlike the Supervisor-based docker/Dockerfile, this image runs uvicorn
# directly as PID 1 and applies the control-plane Alembic migrations on boot.
# Configuration comes from the environment (see env/env.dev for the full list).
# Required at run time:
#   AGENTLENS_OB_URL, SIGNOZ_OB_URL, SIGNOZ_ORG_ID, ANTCOLLECTOR_ENDPOINT,
#   AIVISION_INGEST_TOKEN_URL, AGENTLENS_TOKEN

# Keep build/runtime Python identical and uv in the build stage only.
FROM python:3.11.14-slim-bookworm@sha256:549988ff0804593d8373682ef5c0f0ceee48328abaaa2e054241c23f5c324751 AS python-base

# ── Stage 1: resolve the Python environment ─────────────────────────────────
FROM python-base AS builder
COPY --from=ghcr.io/astral-sh/uv:0.9.30@sha256:538e0b39736e7feae937a65983e49d2ab75e1559d35041f9878b7b7e51de91e4 /uv /usr/local/bin/uv

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# The builder assembles the Python environment without a compiler.
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# src layout: config.py resolves env/ relative to the source tree, so the
# project is installed editable from /app (uv's default for workspace roots).
COPY src/ ./src
COPY env/ ./env
COPY obschema/ ./obschema
RUN uv sync --frozen --no-dev

# ── Stage 2: runtime ────────────────────────────────────────────────────────
FROM python-base AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/agentlens

WORKDIR /app
COPY --from=builder /app /app
ARG AIVISION_BUILD_INFO_BASE64=e30=
RUN mkdir -p /etc/aivision \
    && printf '%s' "$AIVISION_BUILD_INFO_BASE64" | base64 -d > /etc/aivision/build-info.json \
    && chmod 444 /etc/aivision/build-info.json
COPY docker/selfhost-entrypoint.sh /usr/local/bin/agentlens-entrypoint
RUN chmod +x /usr/local/bin/agentlens-entrypoint

# AIVISION_ENV=dev selects env/env.dev (single-node defaults: the master
# executes tasks itself). Every value there can be overridden from the env.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    AIVISION_ENV=dev \
    AGENTLENS_PORT=8081 \
    AGENTLENS_LOG_DIR=/var/log/agentlens \
    AGENTLENS_LOG_STDOUT=true

EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/agentlens-entrypoint"]
