# Django Settings - 开发环境
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# 切换模式说明：

DB_ENGINE=mysql.connector.django
DB_NAME=aivision_dev_ds
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=2881

# Browser origins (comma-separated lists; set to your deployment URL)
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Logging (可选: DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO

# Query Adapter 配置已迁移到数据库 aivision_datasource 表
LANGFUSE_INTERNAL_AUTH_VALUE=

# OpenTelemetry 自观测
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SEMCONV_STABILITY_OPT_IN=http

# V2 Agent Query Encryption - 本地开发
# 开启加密后前端会用 AES-GCM 加密 payload，后端用同一密钥解密
# 此密钥仅用于本地开发，生产环境必须使用独立密钥
AGENT_QUERY_ENCRYPTION_ENABLED=True
AGENT_QUERY_ALLOW_PLAIN=True
# Example key only; override this key map with deployment-specific keys.
AGENT_QUERY_ENCRYPTION_KEYS={"dashboard-query-v1": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY"}

# AgentLens 诊断引擎代理配置
AGENTLENS_BASE_URL=http://localhost:8080
AGENTLENS_TOKEN=dev-token

# AI Vision OTLP 接入令牌(方案丙) - 本地开发
# 控制面用它 HMAC 签发短生命周期接入令牌；采集网关(antcollector aivisionauth)
# 用同名 AIVISION_INGEST_SECRET 离线验签。两处必须同值。仅本地开发使用。
# 网关启动脚本 run-antcollector-gw.mjs 的 AIVISION_INGEST_SECRET 需与此一致。
AIVISION_INGEST_SECRET=localdev-aivision-ingest-secret-2026
AIVISION_INGEST_TOKEN_TTL_SECONDS=900
# org 不再写死:由 bootstrap_signoz_integration 在部署时注册 signoz root 产出 orgId,
# 回填到运行期设置供 build_ingest_token 的 org claim 使用(见 settings.AIVISION_INGEST_ORG_ID,默认空)。

SITE_URL=http://localhost:5174

# 个人空间默认不提供内置诊断任务(自动 provision 已关闭)；本地需要验证时再改为 true。
AIVISION_PERSONAL_DIAGNOSIS_ENABLED=false
