# Copy outside source control with mode 0600. Reuse this file on retries/upgrades.
# Choose the Compose file explicitly: compose.yaml, compose.seekdb.yaml,
# compose.external-oceanbase.yaml or compose.external-seekdb.yaml.
NAMESPACE=aivision
AIV_STATE_DIR=${HOME}/.aivision/forge/aivision/state
AIV_LOG_DIR=${HOME}/.aivision/forge/aivision/logs
DOCKER_NETWORK=aivision-net
# Leave IMAGE_REGISTRY unset to use the official product packages.
# Set it only for a mirror layout using the historical image names, or set
# explicit role image refs below for a different layout.
# IMAGE_REGISTRY=registry.example.org/ai-vision
IMAGE_TAG=latest
IMAGE_PULL=missing
# Optional verified Release record. Empty leaves the installed product version unknown.
AIVISION_RELEASE_MANIFEST_BASE64=

# Require matching images: /app/collector healthcheck --ready,
# /app/signoz healthcheck --ready, SIGNOZ_ORG_ID_FILE, SQL readiness and bounded shutdown.
# Source support in main does not establish a release. Set verified images here.
# DATA_BACKEND_IMAGE=ghcr.io/antgroup/ai-vision/data-backend:latest
# INGEST_GATEWAY_IMAGE=local/ingest-gateway:dev
# BACKEND_IMAGE=local/backend:dev
# DIAGNOSIS_IMAGE=local/diagnosis:dev
# FRONTEND_IMAGE=local/frontend:dev

BIND_ADDR=127.0.0.1
PUBLIC_HOST=127.0.0.1
# Select once to cover ALL retained traces; never regenerate during retries.
AIVISION_NATIVE_TRACE_HISTORY_START=

# Standard query defaults; emergency overrides preserve filter semantics.
# Legacy AIVISION_QUERY_MODE=auto|raw remains accepted; role spelling wins if both are set.
BACKEND_QUERY_MODE=auto
# false durably suspends derived maintenance; true alone does not resume it after repair.
# Legacy SIGNOZ_AIVISION_PROJECTION_MAINTENANCE_ENABLED remains accepted.
DATA_BACKEND_PROJECTION_MAINTENANCE_ENABLED=true

# Fill with private, nonempty deployment credentials. Database passwords must
# contain only letters, digits, underscore and hyphen.
OB_TENANT_PASSWORD=
OB_SYS_PASSWORD=
SECRET_KEY=
SIGNOZ_INGEST_INTERNAL_KEY=
AIVISION_INGEST_SECRET=
AGENTLENS_TOKEN=
SIGNOZ_USER_ROOT_PASSWORD=
SIGNOZ_ROOT_EMAIL=admin@example.com
SIGNOZ_ROOT_ORG_NAME=AI Vision

# External database only (must be reachable from containers).
# OB_HOST=database.example.com
# OB_HOST_PORT=2881
# OB_USER=root@aivision
# OB_USER_URL=root%40aivision
