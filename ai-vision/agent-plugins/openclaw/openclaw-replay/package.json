{
  "name": "@aivision/openclaw-replay",
  "version": "0.2.2",
  "description": "OpenClaw transcript recorder and replay/report plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openclaw-replay": "./dist/src/report.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "npm run clean && node scripts/build.mjs && npm run build:types && npm run copy-manifest",
    "build:types": "tsc --emitDeclarationOnly --declarationMap false",
    "copy-manifest": "cp openclaw.plugin.json dist/",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "npm run build && tsx scripts/test-local-report.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "replay": "tsx src/report.ts",
    "report": "tsx src/report.ts"
  },
  "dependencies": {
    "@aivision/observ-openclaw": "file:../observ-openclaw"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/otlp-transformer": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.1",
    "openclaw": "^2026.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "license": "MIT"
}
