{
  "name": "@aivision/observ-openclaw",
  "version": "0.5.3",
  "description": "OpenClaw Agent Observability - OpenTelemetry instrumentation for AI Agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@aivision/observ-openclaw",
      "defaultChoice": "npm"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./semconv": {
      "import": "./dist/src/semconv.js",
      "types": "./dist/src/semconv.d.ts"
    },
    "./hooks": {
      "import": "./dist/src/hooks/index.js",
      "types": "./dist/src/hooks/index.d.ts"
    },
    "./telemetry-extensions": {
      "import": "./dist/src/telemetry-extensions.js",
      "types": "./dist/src/telemetry-extensions.d.ts"
    }
  },
  "scripts": {
    "generate-config": "tsx scripts/generate-keys.ts && node scripts/verify-config.mjs",
    "generate-keys": "npm run generate-config",
    "build": "npm run clean && npm run generate-config && npm run build:js && npm run build:types && npm run copy-manifest",
    "build:js": "node ./scripts/build.mjs",
    "build:types": "tsc --emitDeclarationOnly --declarationMap false",
    "copy-manifest": "cp openclaw.plugin.json dist/",
    "prepack": "npm run build",
    "verify:packed": "node ./scripts/verify-packed.mjs",
    "test:edition": "tsx --test scripts/api-error-semantics.test.ts scripts/compaction-delta-semantics.test.ts scripts/event-body-semantics.test.ts scripts/generate-config.test.ts scripts/logger-paths.test.ts scripts/model-call-timing.test.ts scripts/response-id-semantics.test.ts scripts/runtime-logger-config.test.ts scripts/semconv-span-helpers.test.ts scripts/session-lifecycle-semantics.test.ts scripts/native-cli-lifecycle.test.ts scripts/skill-detection.test.ts scripts/subagent-correlation.test.ts scripts/media-content.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/otlp-transformer": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "smol-toml": "^1.3.1",
    "esbuild": "^0.28.1",
    "openclaw": "^2026.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "keywords": [
    "opentelemetry",
    "observability",
    "ai-agent",
    "tracing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antgroup/ai-vision.git",
    "directory": "ai-vision/agent-plugins/openclaw/observ-openclaw"
  }
}
