# @weaver.rule.branch: api-duration
# @weaver.rule.check.zh: 当 `agent.api_request.duration` 的 unit 不是 `ms` 时命中。
# @weaver.rule.fix.zh: 将 RED duration 指标 unit 设置为 `ms`。
deny contains make_advice(
    "metric_duration_wrong_unit",
    "violation",
    {"metric_name": get_metric_name, "expected_unit": "ms"},
    sprintf("Metric '%s': Duration metrics must use unit 'ms'.", [get_metric_name])
) if {
    _is_api_request_duration
    not get_metric_unit == "ms"
}

