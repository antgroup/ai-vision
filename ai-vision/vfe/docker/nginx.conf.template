# nginx site for the aivision-fe image. Rendered by the official image's
# envsubst hook; deployment settings come from the container env.

# Opt in only behind a trusted ingress that overwrites client-supplied
# X-Forwarded-Proto. Direct deployments ignore that header by default. Accept
# only a single HTTP(S) scheme; missing or malformed values use this connection.
map "${AIVISION_TRUST_PROXY_HEADERS}:$http_x_forwarded_proto" $aivision_forwarded_proto {
    default $scheme;
    ~*^(true|on|ok|y|yes|1):https$ https;
    ~*^(true|on|ok|y|yes|1):http$ http;
}

server {
    listen ${FE_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Onboarding scripts and plugin downloads can be several MB.
    client_max_body_size 32m;

    # Synchronous LLM Trials cover the backend's finite 933-second budget.
    # URI anchoring excludes Rule Trial and ordinary API operations.
    location ~ ^/api/v1/spaces/[^/]+/diagnose/(?:diagnosers/llm/trial|specialists/trial)\z {
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 963s;
    }

    # Sandbox Rule Trials include bounded creation, execution and verified
    # cleanup within Django's 600-second budget. Keep transport overhead here
    # without extending unrelated API requests.
    location ~ ^/api/v1/spaces/[^/]+/diagnose/diagnosers/rule/trial\z {
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aivision_forwarded_proto;
        proxy_read_timeout 630s;
    }

    # Match Django and SigNoz's default encoded OTLP request budget. Keep
    # ordinary API requests on the server-wide 32 MiB limit.
    location = /api/public/otel/v1/traces {
        client_max_body_size 64m;
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aivision_forwarded_proto;
        proxy_read_timeout 300s;
    }

    # Same-origin API: the browser and the `aiv connect` installer both reach
    # the backend through this origin (AIVISION_PUBLIC_BASE_URL points here).
    location /api/ {
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aivision_forwarded_proto;
        proxy_read_timeout 300s;
    }

    location /openapi/ {
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aivision_forwarded_proto;
        proxy_read_timeout 300s;
    }

    # Official SDK trace URLs resolve the authorized Agent project in Django.
    location /project/ {
        proxy_pass ${BE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets are immutable.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;

        # Older nginx mime.types omit .mjs; PDF.js uses it for its module worker.
        location ~ \.mjs\z {
            types { application/javascript mjs; }
            try_files $uri =404;
        }
    }

    # SPA fallback: every other path is a client-side route.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
