{
  "name": "observ-dsh",
  "version": "0.2.0",
  "description": "DeepSeek Harness (dsh) observability plugin - OpenTelemetry traces, metrics, and events aligned with AIVision/Ant semantic conventions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./http-runtime": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/otlp-transformer": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.30.0",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0 || 0.1.7-rc.2 || >=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0 || 0.1.7-rc.2 || >=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "esbuild": "0.28.2",
    "typescript": "5.7.2",
    "@types/node": "^24.0.0",
    "semver": "7.7.3"
  },
  "files": [
    "dist",
    "configs",
    "dsh.plugin.json"
  ],
  "keywords": [
    "opentelemetry",
    "observability",
    "ai-agent",
    "deepseek",
    "dsh",
    "tracing"
  ],
  "license": "MIT"
}
