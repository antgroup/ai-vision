# @weaver.rule.title.zh: metric:golden 禁用字段: metric_forbidden_error_type
# @weaver.rule.zh: RED 指标禁止把原始 `error.type` 作为维度；应使用低基数 `agentic.error.category`，错误明细保留在 event。
# @weaver.rule.entity: metric:golden
# @weaver.rule.category.zh: 禁用字段
# @weaver.rule.fields: error.type, agentic.error.category
# @weaver.rule.subject: field:error.type
# @weaver.rule.placement: metric_data_point_attributes
# @weaver.rule.constraint.type: forbidden_presence
# @weaver.rule.check.zh: 当 RED golden metric data point 属性中出现 `error.type` 时命中。
# @weaver.rule.fix.zh: 将指标维度改为低基数 `agentic.error.category`；原始 `error.type` 放入可关联的 event 明细。
deny contains make_advice(
    "metric_forbidden_error_type",
    "violation",
    {"metric_name": get_metric_name},
    sprintf("Metric '%s': Forbidden attribute 'error.type' found. Use bounded 'agentic.error.category' on metrics and keep raw error details in events.", [get_metric_name])
) if {
    _is_red_golden_metric
    metric_dp_has_forbidden_attr("error.type")
}

