# Optional fixed evaluation environment. No AgentLens service implementation or
# credentials are present in the final image. This source producer emits native
# owned modules; private delivery qualification remains a separate contract.
ARG PYTHON_IMAGE=python:3.11.14-slim-bookworm@sha256:549988ff0804593d8373682ef5c0f0ceee48328abaaa2e054241c23f5c324751
ARG WORKER_BUILD_IMAGE=python:3.11.14-slim-bookworm@sha256:549988ff0804593d8373682ef5c0f0ceee48328abaaa2e054241c23f5c324751
FROM ${WORKER_BUILD_IMAGE} AS builder
RUN command -v gcc || (apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*)
COPY native/requirements-build.txt /build/requirements-build.txt
RUN /usr/local/bin/python3.11 -m pip install --no-cache-dir -r /build/requirements-build.txt
COPY native/custom_rule_worker.c native/enhanced_rule_worker.c /source/native/
COPY src/agentlens/diagnoser/executors/rule/custom/worker_main.py \
     src/agentlens/diagnoser/executors/rule/custom/enhanced_contract.py \
     src/agentlens/diagnoser/executors/rule/custom/enhanced_context.py \
     src/agentlens/diagnoser/executors/rule/custom/enhanced_worker.py \
     /source/src/agentlens/diagnoser/executors/rule/custom/
COPY docker/build-sandbox-worker.py /build/build-sandbox-worker.py
RUN /usr/local/bin/python3.11 /build/build-sandbox-worker.py --source /source --output /worker --enhanced

FROM ${PYTHON_IMAGE} AS runtime
COPY docker/requirements-rule-runtime.txt /tmp/requirements-rule-runtime.txt
RUN /usr/local/bin/python3.11 -m pip install --no-cache-dir --require-hashes --only-binary=:all: \
      --target /app/rule-runtime/site-packages -r /tmp/requirements-rule-runtime.txt \
    && rm /tmp/requirements-rule-runtime.txt
COPY --from=builder /worker/rule-runtime/ /app/rule-runtime/
COPY --from=builder /worker/agentlens-rule-worker /app/src/agentlens-rule-worker
COPY --from=builder /worker/agentlens_rule_worker_impl*.so /app/src/
# The manifest is generated by the same locked input in the build context; its
# SHA256 build argument is independently checked by --check-runtime in CI.
COPY docker/rule-runtime-manifest.json /app/rule-runtime/manifest.json
RUN mkdir -p /work && chown 1000:1000 /work && chmod 755 /work
ARG SOURCE_SHA
ARG SOURCE_REPOSITORY_URL
ARG RUNTIME_MANIFEST_SHA256
LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY_URL}" \
      org.opencontainers.image.revision="${SOURCE_SHA}" \
      io.aivision.rule-runtime="python-eval-v1" \
      io.aivision.sandbox.max-input-bytes="16777216" \
      io.aivision.rule-runtime.manifest-sha256="${RUNTIME_MANIFEST_SHA256}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["/app/rule-runtime/enhanced-worker"]
