# @weaver.rule.title.zh: metric:golden 不变量: metric_count_wrong_unit
# @weaver.rule.zh: RED Rate/Error count 指标必须使用 `{count}` 单位。
# @weaver.rule.entity: metric:golden
# @weaver.rule.category.zh: 不变量
# @weaver.rule.fields: agent.api_request.count, agent.api_request.error.count, agent.tool_call.count, agent.tool_call.error.count
# @weaver.rule.subject: field:metric.unit
# @weaver.rule.placement: metric
# @weaver.rule.constraint.type: invariant
# @weaver.rule.check.zh: 当 RED Rate/Error count 指标的 unit 不是 `{count}` 时命中。
# @weaver.rule.fix.zh: 将 RED Rate/Error count 指标 unit 设置为 `{count}`。
deny contains make_advice(
    "metric_count_wrong_unit",
    "violation",
    {"metric_name": get_metric_name, "expected_unit": "{count}"},
    sprintf("Metric '%s': Count metrics must use unit '{count}'.", [get_metric_name])
) if {
    _is_count_metric
    not get_metric_unit == "{count}"
}

# @weaver.rule.title.zh: metric:golden 不变量: metric_duration_wrong_unit
# @weaver.rule.zh: RED duration 指标必须使用 `ms` 单位。
