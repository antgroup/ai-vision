deny contains make_advice(
    "metric_forbidden_error_message",
    "violation",
    {"metric_name": get_metric_name},
    sprintf("Metric '%s': Forbidden attribute 'error.message' found. Error details belong in events, not metric dimensions.", [get_metric_name])
) if {
