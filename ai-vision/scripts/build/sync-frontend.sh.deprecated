#!/usr/bin/env bash
# 快速同步前端构建产物到 Django 静态目录
# 用途：开发环境快速更新静态文件
# 使用：./scripts/build/sync-frontend.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BACKEND_DIR="${PROJECT_ROOT}/aivision-py-be"
FRONTEND_DIR="${PROJECT_ROOT}/vfe"

echo "Syncing frontend to Django static..."

cd "${FRONTEND_DIR}"

FRONTEND_PM="npm"

echo "[1/5] Checking frontend dependencies..."
if command -v pnpm >/dev/null 2>&1 && [ -f "pnpm-lock.yaml" ]; then
  FRONTEND_PM="pnpm"
  if [ ! -d "node_modules" ] || [ "pnpm-lock.yaml" -nt "node_modules/.modules.yaml" ] || ! pnpm list --depth=0 >/dev/null 2>&1; then
    echo "Frontend dependencies are missing or out of date. Installing with pnpm..."
    pnpm install --frozen-lockfile
  else
    echo "Frontend dependencies are up to date."
  fi
else
  if [ ! -d "node_modules" ] || ! npm ls --depth=0 >/dev/null 2>&1; then
    echo "Frontend dependencies are missing or out of date. Installing with npm..."
    npm install
  else
    echo "Frontend dependencies are up to date."
  fi
fi

echo "[2/5] Building frontend..."
"${FRONTEND_PM}" run build

echo "[3/5] Copying dist to static/..."
rm -rf "${BACKEND_DIR}/static"/*
cp -r "${FRONTEND_DIR}/dist/." "${BACKEND_DIR}/static/"

echo "[4/5] Copying index.html to templates/..."
mkdir -p "${BACKEND_DIR}/templates"
cp "${FRONTEND_DIR}/dist/index.html" "${BACKEND_DIR}/templates/"

echo "[5/5] Collecting static files..."
cd "${BACKEND_DIR}"
UV_CACHE_DIR=/tmp/uv-cache uv run python manage.py collectstatic --noinput

echo "Done!"
