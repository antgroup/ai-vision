# Only use an images.py sanitized context, never the repository as context.
ARG RUNTIME_BASE
FROM ${RUNTIME_BASE}
WORKDIR /app
COPY runtime/ /app/
COPY provider/ /agent-plugins/
COPY metadata/build-info.json /etc/aivision/build-info.json
COPY aiv-http-probe /usr/local/bin/aiv-http-probe
RUN mkdir -p /var/log/aivision
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AIVISION_ENV=container \
    AIVISION_AGENT_PLUGINS_DIR=/agent-plugins \
    AIVISION_PLUGIN_ARTIFACTS_DIR=/agent-plugins/dist \
    AIVISION_LOG_DIR=/var/log/aivision \
    BE_PORT=8001
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 CMD exec /usr/local/bin/aiv-http-probe 127.0.0.1 "${BE_PORT:-8001}" /api/v1/ready 3
ENTRYPOINT ["/app/docker-entrypoint.sh"]
